<div class="nq-page-header">
  <h1><%= @dashboard.name %></h1>
  <p class="nq-muted nq-resource-meta">
    Created by <%= @dashboard.creator&.name || "—" %>
    · Created <%= @dashboard.created_at.to_fs(:long) %>
    · Updated <%= @dashboard.updated_at.to_fs(:long) %>
  </p>
  <div class="nq-actions">
    <%= link_to new_dashboard_chart_path(@dashboard), class: "nq-btn nq-btn-primary" do %>
      <%= nq_icon(:chart) %>
      <span>New chart</span>
    <% end %>
    <%= link_to dashboard_embed_path(@dashboard), class: "nq-btn" do %>
      <%= nq_icon(:share) %>
      <span>Embed</span>
    <% end %>
    <%= link_to edit_dashboard_path(@dashboard), class: "nq-btn" do %>
      <%= nq_icon(:edit) %>
      <span>Edit</span>
    <% end %>
    <% if @dashboard.archived? %>
      <%= button_to unarchive_dashboard_path(@dashboard), method: :patch, class: "nq-btn" do %>
        <%= nq_icon(:unarchive) %>
        <span>Unarchive</span>
      <% end %>
    <% else %>
      <%= button_to archive_dashboard_path(@dashboard), method: :patch, class: "nq-btn", form: { data: { turbo_confirm: "Archive this dashboard?" } } do %>
        <%= nq_icon(:archive) %>
        <span>Archive</span>
      <% end %>
    <% end %>
    <%= button_to dashboard_path(@dashboard), method: :delete, class: "nq-btn nq-btn-danger", form: { data: { turbo_confirm: "Remove this dashboard?" } } do %>
      <%= nq_icon(:trash) %>
      <span>Remove</span>
    <% end %>
  </div>
</div>

<% if @dashboard.archived? %>
  <%= nq_flash_card "This dashboard is archived.", type: :warning, toast: false %>
<% end %>

<% can_edit = can_curate_shareable?(@dashboard) %>
<% wiring_name = params[:wire].to_s.presence if can_edit %>
<% editing_parameters = can_edit && (params[:edit] == "parameters" || wiring_name.present?) %>
<% wiring_parameter = @filter_dashboard.parameter_definitions.find { |row| row["name"] == wiring_name } %>
<% if @filter_dashboard.parameter_definitions.any? || can_edit %>
  <div class="nq-dashboard-filters">
    <%= render "parameters",
               dashboard: @dashboard,
               filter_dashboard: @filter_dashboard,
               cards: @dashboard_cards,
               invalid_parameter_names: @invalid_parameter_names,
               wiring_name: wiring_name,
               editing_parameters: editing_parameters,
               can_edit: can_edit %>
  </div>
<% end %>

<% if wiring_parameter %>
  <% eligible_cards = @dashboard_cards.select { |card| card.chart.uses_parameter?(wiring_parameter["name"]) } %>
  <% unlinked_cards = eligible_cards.reject { |card| @filter_dashboard.parameter_linked_to_chart?(wiring_parameter, card.chart) } %>
  <div class="nq-dashboard-wire">
    <p>Choose <code>{{<%= wiring_parameter["name"] %>}}</code> on each chart.</p>
    <% if unlinked_cards.any? %>
      <%= form_with url: parameter_charts_dashboard_path(@dashboard, name: wiring_parameter["name"], edit: "parameters", wire: wiring_parameter["name"]), method: :patch do %>
        <%= hidden_field_tag "chart_ids[]", "" %>
        <% eligible_cards.each do |card| %>
          <%= hidden_field_tag "chart_ids[]", card.chart.id %>
        <% end %>
        <%= submit_tag "Connect every chart that uses {{#{wiring_parameter["name"]}}}", class: "nq-btn" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<div class="nq-dashboard-grid" data-controller="dashboard-grid">
  <% @dashboard_cards.each do |card| %>
    <%= render "nquery/dashboards/chart_card",
               card: card,
               dashboard: @dashboard,
               card_result: @card_results[card],
               can_edit: can_edit,
               wiring_parameter: wiring_parameter %>
  <% end %>
</div>
