<div class="nq-page-header">
  <h1>Edit dashboard: <%= @dashboard.name %></h1>
</div>

<%= form_with model: @dashboard, url: dashboard_path(@dashboard), method: :patch do |f| %>
  <div class="nq-card nq-mb">
    <% if @dashboard.errors.any? %>
      <div class="nq-form-errors" role="alert">
        <p><strong>Please fix the following:</strong></p>
        <ul>
          <% @dashboard.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="nq-form-row">
      <%= f.label :name %>
      <%= f.text_field :name, class: "nq-input" %>
    </div>
    <div class="nq-form-row">
      <%= f.label :description %>
      <%= f.text_area :description, class: "nq-textarea", rows: 2 %>
    </div>
    <div class="nq-form-row">
      <%= f.label :collection_id, "Collection" %>
      <%= f.collection_select :collection_id, @collections, :id, :name, { prompt: "Select a collection" }, class: "nq-input" %>
    </div>
    <fieldset class="nq-form-row">
      <legend>Parameters</legend>
      <% (@dashboard.parameter_definitions + [{ "name" => "", "type" => "date", "default" => "" }]).each_with_index do |definition, index| %>
        <div class="nq-form-row">
          <%= label_tag "dashboard_parameter_#{index}_name", "Name" %>
          <%= text_field_tag "dashboard[parameters][][name]", definition["name"], id: "dashboard_parameter_#{index}_name", class: "nq-input", autocomplete: "off" %>
          <%= hidden_field_tag "dashboard[parameters][][type]", "date", id: "dashboard_parameter_#{index}_type" %>
          <%= label_tag "dashboard_parameter_#{index}_default", "Default" %>
          <%= date_field_tag "dashboard[parameters][][default]", definition["default"].presence, id: "dashboard_parameter_#{index}_default", class: "nq-input" %>
        </div>
      <% end %>
    </fieldset>
    <%= f.submit "Save", class: "nq-btn nq-btn-primary" %>
  </div>
<% end %>

<div class="nq-dashboard-grid nq-dashboard-edit" data-controller="dashboard-grid">
  <% @dashboard.dashboard_cards.each do |card| %>
    <div class="nq-dashboard-card nq-draggable"
         style="grid-column: span <%= card.width %>; grid-row: span <%= card.height %>;"
         data-dashboard-grid-target="card"
         data-card-id="<%= card.id %>"
         draggable="true">
      <h3><%= card.chart.name %></h3>
      <p class="nq-muted">Drag to reposition (preview)</p>
    </div>
  <% end %>
</div>
