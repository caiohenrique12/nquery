<div class="nq-page-header"><h1>New collection</h1></div>

<%= form_with model: @collection, url: (@parent_collection ? collection_collections_path(@parent_collection) : collections_path), class: "nq-form nq-card" do |f| %>
  <div class="nq-form-row">
    <%= f.label :name %>
    <%= f.text_field :name, class: "nq-input" %>
  </div>
  <% unless @parent_collection %>
    <div class="nq-form-row">
      <%= f.label :parent_id, "Parent collection" %>
      <%= f.collection_select :parent_id, @parent_collections, :id, :name, { include_blank: "None" }, class: "nq-input" %>
    </div>
  <% end %>
  <%= f.submit "Create", class: "nq-btn nq-btn-primary" %>
<% end %>
