<div class="nq-page-header"><h1>Edit collection: <%= @collection.name %></h1></div>

<%= form_with model: @collection, url: collection_path(@collection), method: :patch, class: "nq-form nq-card" do |f| %>
  <div class="nq-form-row">
    <%= f.label :name %>
    <%= f.text_field :name, class: "nq-input" %>
  </div>
  <% unless @collection.kind == "root" %>
    <div class="nq-form-row">
      <%= f.label :parent_id, "Parent collection" %>
      <%= f.collection_select :parent_id, @parent_collections, :id, :name, { include_blank: "None" }, class: "nq-input" %>
    </div>
  <% end %>
  <%= f.submit "Save", class: "nq-btn nq-btn-primary" %>
<% end %>
