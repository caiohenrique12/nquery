<%= render layout: "nquery/shared/auth_shell",
           locals: {
             title: "Welcome back",
             subtitle: "Sign in to explore your charts and dashboards."
           } do %>
  <%= form_with url: nquery_user_session_path,
                scope: :nquery_user,
                html: { class: "nq-form nq-auth-form", id: "new_nquery_user" } do |form| %>
    <div class="nq-form-row">
      <%= form.label :email, "Email address" %>
      <%= form.email_field :email,
            class: "nq-input",
            required: true,
            autofocus: true,
            autocomplete: "email",
            placeholder: "you@company.com" %>
    </div>
    <div class="nq-form-row">
      <%= form.label :password, "Password" %>
      <%= form.password_field :password,
            class: "nq-input",
            required: true,
            autocomplete: "current-password",
            placeholder: "Enter your password" %>
    </div>
    <button type="submit" class="nq-btn nq-btn-primary nq-btn-block nq-auth-submit">Sign in</button>
  <% end %>
<% end %>
