<div class="nq-page-header">
  <h1>Query logs</h1>
  <p class="nq-muted">Search query execution history</p>
</div>

<section class="nq-card">
  <%= form_with url: admin_logs_path, method: :get, class: "nq-form" do %>
    <div class="nq-grid nq-grid-3">
      <div class="nq-form-row">
        <label for="user">User</label>
        <%= text_field_tag :user, params[:user], class: "nq-input", placeholder: "Name or email" %>
      </div>
      <div class="nq-form-row">
        <label for="collection">Collection</label>
        <%= select_tag :collection,
              options_from_collection_for_select(@collections, :id, :name, params[:collection]),
              include_blank: "All collections",
              class: "nq-input" %>
      </div>
      <div class="nq-form-row">
        <label for="dashboard">Dashboard</label>
        <%= select_tag :dashboard,
              options_from_collection_for_select(@dashboards, :id, :name, params[:dashboard]),
              include_blank: "All dashboards",
              class: "nq-input" %>
      </div>
      <div class="nq-form-row">
        <label for="from">From</label>
        <%= date_field_tag :from, params[:from], class: "nq-input" %>
      </div>
      <div class="nq-form-row">
        <label for="to">To</label>
        <%= date_field_tag :to, params[:to], class: "nq-input" %>
      </div>
    </div>
    <div style="display: flex; gap: 0.5rem;">
      <%= submit_tag "Search", class: "nq-btn nq-btn-primary" %>
      <%= link_to "Clear", admin_logs_path, class: "nq-btn nq-btn-ghost" %>
    </div>
  <% end %>
</section>

<%= nq_card_table columns: ["User", "Query", "Collection", "Dashboard", "Status", "When"], class: "nq-mt nq-logs-table" do %>
  <% if @audits.any? %>
    <% @audits.each do |audit| %>
      <%
        statement = audit.statement.to_s
        status_class = audit.status == "success" ? "nq-badge-success" : "nq-badge-error"
      %>
      <tr>
        <td data-label="User"><%= audit.user&.name || "—" %></td>
        <td data-label="Query">
          <code class="nq-logs-query" title="<%= statement %>"><%= truncate(statement, length: 80) %></code>
        </td>
        <td data-label="Collection"><%= audit.query&.collection&.name || "—" %></td>
        <td data-label="Dashboard"><%= audit.query&.chart&.dashboard_cards&.first&.dashboard&.name || "—" %></td>
        <td data-label="Status"><span class="nq-badge <%= status_class %>"><%= audit.status %></span></td>
        <td data-label="When">
          <time datetime="<%= audit.created_at.iso8601 %>" title="<%= l(audit.created_at, format: :long) %>">
            <%= time_ago_in_words(audit.created_at) %> ago
          </time>
        </td>
      </tr>
    <% end %>
  <% else %>
    <tr class="nq-logs-empty">
      <td colspan="6" class="nq-muted">No query logs found.</td>
    </tr>
  <% end %>
<% end %>
