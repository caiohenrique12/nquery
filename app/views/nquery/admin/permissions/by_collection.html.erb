<div class="nq-page-header"><h1>Permissions</h1></div>
<div class="nq-tabs">
  <%= link_to "By group", by_group_admin_permissions_path, class: "nq-tab" %>
  <%= link_to "By data source", by_data_source_admin_permissions_path, class: "nq-tab" %>
  <%= link_to "By collection", by_collection_admin_permissions_path, class: "nq-tab active" %>
</div>
<% if @warnings&.any? %>
  <div class="nq-flash nq-flash-alert"><% @warnings.each { |w| %><p><%= w %></p><% } %></div>
<% end %>
<%= render "nquery/admin/permissions/collection" %>
