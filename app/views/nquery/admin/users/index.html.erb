<div class="nq-page-header"><h1>Users</h1><%= link_to "Invite user", new_admin_user_path, class: "nq-btn nq-btn-primary" %></div>

<div class="nq-card nq-card-table">
  <table class="nq-table">
    <thead><tr><th>Email</th><th>Name</th><th>Groups</th><th></th></tr></thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.email %></td>
          <td><%= user.name %></td>
          <td>
            <div class="nq-tags">
              <% user.groups.each do |group| %>
                <span class="nq-badge"><%= group.name %></span>
              <% end %>
            </div>
          </td>
          <td>
            <div class="nq-actions">
              <%= link_to "Edit", edit_admin_user_path(user), class: "nq-btn" %>
              <% unless user == current_nquery_user %>
                <%= button_to "Disable",
                              deactivate_admin_user_path(user),
                              method: :patch,
                              class: "nq-btn",
                              form: { data: { turbo_confirm: "Disable #{user.name}?" } } %>
                <%= button_to "Remove",
                              admin_user_path(user),
                              method: :delete,
                              class: "nq-btn nq-btn-danger",
                              form: { data: { turbo_confirm: "Remove #{user.name}? This cannot be undone." } } %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
