<div class="nq-page-header"><h1>Edit user</h1></div>
<%= form_with model: @user, url: admin_user_path(@user), method: :patch, class: "nq-form nq-card" do |f| %>
  <div class="nq-form-row"><%= f.label :email %><%= f.email_field :email, class: "nq-input" %></div>
  <div class="nq-form-row"><%= f.label :first_name %><%= f.text_field :first_name, class: "nq-input" %></div>
  <div class="nq-form-row"><%= f.label :last_name %><%= f.text_field :last_name, class: "nq-input" %></div>
  <div class="nq-form-row"><%= f.label :password, "New password (optional)" %><%= f.password_field :password, class: "nq-input" %></div>
  <div class="nq-form-row">
    <label>Groups</label>
    <% @groups.each do |group| %>
      <label class="nq-checkbox">
        <input type="checkbox" name="group_ids[]" value="<%= group.id %>" <%= "checked" if @user.groups.include?(group) %>>
        <%= group.name %>
      </label>
    <% end %>
  </div>
  <%= f.submit "Update", class: "nq-btn nq-btn-primary" %>
<% end %>
